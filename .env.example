# Banco de dados
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# APIs de dados
BRAPI_TOKEN=seu_token_brapi
ANTHROPIC_API_KEY=sk-ant-...

# Servidor
PORT=3002
NODE_ENV=production
BASE_URL=https://fii-advisor-backend.railway.app

# Assinaturas / Pagamento (Asaas)
ASAAS_ENV=sandbox                       # sandbox | production
ASAAS_API_KEY=$aact_...                 # chave de API do Asaas
# ASAAS_API_URL=                        # opcional: sobrescreve a URL base
ASAAS_WEBHOOK_TOKEN=um_token_secreto    # mesmo valor configurado no webhook do Asaas
UPGRADE_URL=https://fiiadvisor.com.br/planos

# Health Check — e-mail de alertas
ALERT_EMAIL_FROM=alerts@fiiadvisor.com.br
ALERT_EMAIL_TO=seu@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_de_app
